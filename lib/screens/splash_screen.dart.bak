import 'dart:async';
import 'dart:ui';
import 'package:cached_network_image/cached_network_image.dart';
import 'package:flutter/material.dart';
import '../constants/constants.dart';
import '../utils/app_images.dart';
import 'home_screen.dart';

// ── Splash palette ────────────────────────────────────────────────────────────
const _deepNavy  = Color(0xFF010B1E);
const _midNavy   = Color(0xFF071E50);
const _navyCore  = Color(0xFF0E3585);
const _gold      = Color(0xFFC89030);
const _goldBright = Color(0xFFF2C44A);
const _copper    = Color(0xFFE0A86A);

class SplashScreen extends StatefulWidget {
  const SplashScreen({super.key});

  @override
  State<SplashScreen> createState() => _SplashScreenState();
}

class _SplashScreenState extends State<SplashScreen>
    with TickerProviderStateMixin {
  late AnimationController _controller;
  late AnimationController _writeController;

  // Shiva — materialises from blur/void to sharp
  late Animation<double> _shivaOpacity;
  late Animation<double> _shivaBlur;
  late Animation<double> _shivaScale;

  // Rest of content (divider, subtitle)
  late Animation<double> _contentFade;

  // Smooth writing reveal
  late Animation<double> _writeAnim;

  @override
  void initState() {
    super.initState();

    _controller = AnimationController(
      duration: const Duration(milliseconds: 2200),
      vsync: this,
    );

    _writeController = AnimationController(
      duration: const Duration(milliseconds: 2400),
      vsync: this,
    );

    _shivaOpacity = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(
        parent: _controller,
        curve: const Interval(0.0, 0.35, curve: Curves.easeIn),
      ),
    );
    _shivaBlur = Tween<double>(begin: 22.0, end: 0.0).animate(
      CurvedAnimation(
        parent: _controller,
        curve: const Interval(0.0, 0.85, curve: Curves.easeOut),
      ),
    );
    _shivaScale = Tween<double>(begin: 0.82, end: 1.0).animate(
      CurvedAnimation(
        parent: _controller,
        curve: const Interval(0.0, 0.85, curve: Curves.easeOut),
      ),
    );
    _contentFade = Tween<double>(begin: 0.0, end: 1.0).animate(
      CurvedAnimation(
        parent: _controller,
        curve: const Interval(0.40, 0.85, curve: Curves.easeIn),
      ),
    );

    _writeAnim = CurvedAnimation(
      parent: _writeController,
      curve: Curves.easeInOutCubic,
    );

    _controller.forward();

    // Start writing after Shiva has materialised
    Future.delayed(const Duration(milliseconds: 850), () {
      if (mounted) _writeController.forward();
    });

    Timer(const Duration(milliseconds: 3800), () {
      if (mounted) {
        Navigator.of(context).pushReplacement(
          PageRouteBuilder(
            pageBuilder: (_, animation, __) => const HomeScreen(),
            transitionsBuilder: (_, animation, __, child) =>
                FadeTransition(opacity: animation, child: child),
            transitionDuration: const Duration(milliseconds: 800),
          ),
        );
      }
    });
  }

  @override
  void dispose() {
    _controller.dispose();
    _writeController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Stack(
        fit: StackFit.expand,
        children: [
          // ── Layer 1: Base gradient — deep navy → navy core → deep navy ──
          const DecoratedBox(
            decoration: BoxDecoration(
              gradient: LinearGradient(
                begin: Alignment.topCenter,
                end: Alignment.bottomCenter,
                colors: [
                  _deepNavy,
                  _midNavy,
                  _navyCore,
                  _midNavy,
                  _deepNavy,
                ],
                stops: [0.0, 0.22, 0.50, 0.78, 1.0],
              ),
            ),
          ),

          // ── Layer 2: Radial blue glow — divine light at centre ──
          const DecoratedBox(
            decoration: BoxDecoration(
              gradient: RadialGradient(
                center: Alignment(0, -0.08),
                radius: 0.72,
                colors: [
                  Color(0x381E78D0),
                  Colors.transparent,
                ],
              ),
            ),
          ),

          // ── Layer 3: Vignette — darkens edges, spotlights centre ──
          DecoratedBox(
            decoration: BoxDecoration(
              gradient: RadialGradient(
                center: Alignment.center,
                radius: 1.35,
                colors: [
                  Colors.transparent,
                  Colors.black.withValues(alpha: 0.50),
                ],
              ),
            ),
          ),

          // ── Layer 4: OM watermark — faint behind Shiva image ──
          Align(
            alignment: const Alignment(0, -0.12),
            child: Text(
              'ॐ',
              style: TextStyle(
                fontSize: 400,
                color: Colors.white.withValues(alpha: 0.028),
                fontWeight: FontWeight.bold,
                height: 1,
              ),
            ),
          ),

          // ── Layer 5: Main content ──
          SafeArea(
            child: Center(
              child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  // Shiva — blur-to-sharp materialisation
                  AnimatedBuilder(
                    animation: _controller,
                    builder: (_, child) {
                      final sigma = _shivaBlur.value;
                      return Opacity(
                        opacity: _shivaOpacity.value,
                        child: Transform.scale(
                          scale: _shivaScale.value,
                          child: ImageFiltered(
                            imageFilter: ImageFilter.blur(
                              sigmaX: sigma,
                              sigmaY: sigma,
                              tileMode: TileMode.decal,
                            ),
                            child: child,
                          ),
                        ),
                      );
                    },
                    child: CachedNetworkImage(
                      imageUrl: AppImages.url('shiva.png'),
                      width: 340,
                      height: 340,
                      fit: BoxFit.contain,
                      placeholder: (_, __) => const SizedBox.shrink(),
                      errorWidget: (_, __, ___) => const SizedBox.shrink(),
                    ),
                  ),
                  const SizedBox(height: 22),

                  // Title — smooth writing reveal
                  SizedBox(
                    height: 56,
                    child: AnimatedBuilder(
                      animation: _writeAnim,
                      builder: (_, child) {
                        final progress = _writeAnim.value;
                        return Stack(
                          alignment: Alignment.centerLeft,
                          children: [
                            // Text clipped to reveal from left → right
                            ClipRect(
                              child: Align(
                                alignment: Alignment.centerLeft,
                                widthFactor: progress,
                                child: child,
                              ),
                            ),
                            // Glowing pen tip at the leading edge
                            if (progress > 0.01 && progress < 0.995)
                              FractionallySizedBox(
                                widthFactor: progress,
                                alignment: Alignment.centerLeft,
                                child: Align(
                                  alignment: Alignment.centerRight,
                                  child: Container(
                                    width: 3,
                                    height: 40,
                                    decoration: BoxDecoration(
                                      borderRadius: BorderRadius.circular(2),
                                      gradient: const LinearGradient(
                                        begin: Alignment.topCenter,
                                        end: Alignment.bottomCenter,
                                        colors: [
                                          Colors.transparent,
                                          Colors.white,
                                          _goldBright,
                                          Colors.white,
                                          Colors.transparent,
                                        ],
                                        stops: [0.0, 0.2, 0.5, 0.8, 1.0],
                                      ),
                                      boxShadow: [
                                        BoxShadow(
                                          color: _goldBright.withValues(alpha: 0.9),
                                          blurRadius: 14,
                                          spreadRadius: 4,
                                        ),
                                        BoxShadow(
                                          color: Colors.white.withValues(alpha: 0.6),
                                          blurRadius: 6,
                                          spreadRadius: 1,
                                        ),
                                      ],
                                    ),
                                  ),
                                ),
                              ),
                          ],
                        );
                      },
                      child: const Text(
                        AppStrings.englishTitle,
                        style: TextStyle(
                          fontFamily: 'Samarkan',
                          fontSize: 42,
                          color: _goldBright,
                          letterSpacing: 4,
                          shadows: [
                            Shadow(
                              offset: Offset(0, 2),
                              blurRadius: 18,
                              color: Color(0xAA1565C0),
                            ),
                            Shadow(
                              offset: Offset(0, 0),
                              blurRadius: 34,
                              color: Color(0x553D9BE8),
                            ),
                          ],
                        ),
                      ),
                    ),
                  ),

                  // Divider, subtitle, loader — fade in
                  AnimatedBuilder(
                    animation: _contentFade,
                    builder: (_, child) =>
                        Opacity(opacity: _contentFade.value, child: child),
                    child: Column(
                      children: [
                        const SizedBox(height: 16),

                        // Ornamental divider
                        Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            _fadeLine(rightFade: false),
                            const SizedBox(width: 10),
                            _dot(),
                            const Padding(
                              padding: EdgeInsets.symmetric(horizontal: 7),
                              child: Text(
                                '✦',
                                style: TextStyle(
                                    color: _goldBright, fontSize: 11),
                              ),
                            ),
                            _dot(),
                            const SizedBox(width: 10),
                            _fadeLine(rightFade: true),
                          ],
                        ),

                        const SizedBox(height: 16),
                        const Text(
                          AppStrings.jyotirlinga,
                          style: TextStyle(
                            fontSize: 17,
                            color: _copper,
                            letterSpacing: 5,
                            fontWeight: FontWeight.w300,
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _fadeLine({required bool rightFade}) => Container(
        width: 52,
        height: 1,
        decoration: BoxDecoration(
          gradient: LinearGradient(
            colors: rightFade
                ? [_gold, Colors.transparent]
                : [Colors.transparent, _gold],
          ),
          borderRadius: BorderRadius.circular(1),
        ),
      );

  Widget _dot() => Container(
        width: 5,
        height: 5,
        decoration: const BoxDecoration(
          color: _goldBright,
          shape: BoxShape.circle,
        ),
      );
}
